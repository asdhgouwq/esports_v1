SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
PORT=3000

# 선택 사항: AI_AUTH_MODE=api_key로 명시한 경우에만 사용합니다.
# ChatGPT 구독 연결에는 별도 OpenAI API 키가 필요하지 않습니다.
OPENAI_API_KEY=
# 요약은 gpt-6-luna / reasoning low로 서버에서 고정합니다.

# 기본값: 로컬 ChatGPT 구독 연동. API 키 결제로 자동 전환하지 않습니다.
AI_AUTH_MODE=chatgpt
FRONTEND_URL=http://127.0.0.1:5173

# 앱의 데이터 연결 화면에서 입력하면 .local/leaguepedia/에 따로 보관됩니다.
# 아래 환경변수로 설정할 수도 있습니다. 이메일 인증 + Cargo Bot 권한 필요.
LEAGUEPEDIA_USERNAME=
LEAGUEPEDIA_BOT_PASSWORD=

# Server-only Supabase key. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=
# Runs while the local backend is running.
WORLDS_AUTO_SYNC=true
WORLDS_YEAR=2026
WORLDS_SYNC_INTERVAL_MINUTES=15
